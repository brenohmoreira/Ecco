{
        "name": "ecco-app",
        "version": "0.0.1",
        "description": "Ecco - Quasar + TypeScript + Pinia + Tailwind",
        "productName": "Ecco",
        "author": "Breno",
        "type": "module",
        "private": true,
        "scripts": {
                "dev": "quasar dev",
                "build": "quasar build",
                "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
                "format": "prettier --write \"**/*.{js,ts,vue,scss,css,html,md,json}\" --ignore-path .gitignore",
                "typecheck": "vue-tsc --noEmit",
                "postinstall": "quasar prepare"
        },
        "engines": {
                "node": "^28 || ^26 || ^24 || ^22 || ^20",
                "npm": ">= 6.13.4"
        },
        "dependencies": {
                "@fontsource/poppins": "^5.3.0",
                "@quasar/extras": "^2.1.0",
                "@vueuse/core": "^15.0.0",
                "axios": "^1.20.0",
                "pinia": "^4.1.0",
                "pinia-plugin-persistedstate": "^4.7.1",
                "quasar": "^2.35.1",
                "vue": "^3.5.44",
                "vue-router": "^5.4.0"
        },
        "devDependencies": {
                "@eslint/js": "^10.0.1",
                "@quasar/app-vite": "^3.10.3",
                "@tailwindcss/vite": "^4.3.3",
                "@types/node": "^26.6.5",
                "@vue/eslint-config-prettier": "^10.2.0",
                "@vue/eslint-config-typescript": "^14.9.0",
                "autoprefixer": "^10.6.1",
                "eslint": "^10.13.0",
                "eslint-plugin-vue": "^10.11.1",
                "globals": "^17.13.0",
                "prettier": "^3.9.10",
                "prettier-plugin-tailwindcss": "^0.8.1",
                "tailwindcss": "^4.3.3",
                "typescript": "^6.0.3",
                "vite-plugin-checker": "^0.14.5",
                "vue-tsc": "^3.3.13"
        }
}
